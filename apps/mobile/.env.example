# Copy to .env.local. EXPO_PUBLIC_* values are embedded in the app bundle — never put secrets here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_CLARITY_PROJECT_ID=
# Google Cloud "Web application" OAuth client ID (the same one configured in Supabase → Auth → Google).
# The Android OAuth client (package name + SHA-1) must also exist in the same Google Cloud project.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
