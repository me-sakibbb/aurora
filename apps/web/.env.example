# Copy to .env.local. NEXT_PUBLIC_* values are embedded in the browser bundle — never put secrets here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# FastAPI backend (aurora-backend), no trailing /api/v1.
NEXT_PUBLIC_API_URL=https://aurora-backend-one.vercel.app
NEXT_PUBLIC_CLARITY_PROJECT_ID=
